PORT=3000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
STORAGE_PATH="../storage"
CORS_ORIGIN=http://localhost:5173

# AI - OpenAI Compatible LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.xueai.me/v1
LLM_MODEL=gpt-4o-mini

# Image Generation (OpenAI-compatible, e.g. api.xueai.me)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.xueai.me/v1
OPENAI_IMAGE_MODEL=z-image-turbo

# Voice (xueai gateway — speech-2.8-hd / tts-1; 复用 LLM_API_KEY 即可)
TTS_API_KEY=
TTS_BASE_URL=https://api.xueai.me/v1
TTS_MINIMAX_BASE_URL=https://api.xueai.me/minimax/v1
TTS_MODEL=speech-2.8-hd
TTS_VOICE=Chinese (Mandarin)_Lyrical_Voice
TTS_LANGUAGE_BOOST=Chinese
# 同步 TTS 模型（tts-1 / gpt-4o-mini-tts）时使用 OpenAI voice 名
TTS_OPENAI_VOICE=alloy

# Voice (ElevenLabs — 可选，优先级高于网关 TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2

# Remotion render
REMOTION_CRF=18
REMOTION_CONCURRENCY=1
REMOTION_CHROMIUM_HEADLESS=true

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
DEMO_USER_EMAIL=demo@xueai.local
