PORT=3000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
STORAGE_PATH="../storage"
CORS_ORIGIN=http://localhost:5173

# AI - OpenAI Compatible LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.xueai.me/v1
