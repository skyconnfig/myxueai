{
  "name": "xueai-video-factory",
  "version": "1.0.0-mvp",
  "private": true,
  "description": "XueAI Video Factory MVP - AI-powered short video production platform",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:remotion": "pnpm --filter remotion dev:studio",
    "remotion:browser": "pnpm --filter remotion browser:ensure",
    "remotion:render": "pnpm --filter remotion render:cli",
    "remotion:studio": "pnpm --filter remotion dev:studio",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "vue-demi"
    ]
  }
}
